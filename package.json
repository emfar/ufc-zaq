{
  "name": "ufc-zaq",
  "version": "1.0.0",
  "private": true,
  "description": "Monthly UFC 4 scoreboard for five friends",
  "license": "UNLICENSED",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test test/*.test.js",
    "backup": "node scripts/backup.js",
    "lint": "prettier --no-error-on-unmatched-pattern --check \"src/**/*.js\" \"scripts/**/*.js\" \"test/**/*.js\" \"public/js/**/*.js\" \"public/css/**/*.css\" \".github/**/*.yml\" \"deploy/**/*.yml\"",
    "format": "prettier --no-error-on-unmatched-pattern --write \"src/**/*.js\" \"scripts/**/*.js\" \"test/**/*.js\" \"public/js/**/*.js\" \"public/css/**/*.css\" \".github/**/*.yml\" \"deploy/**/*.yml\""
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "prettier": "^3.9.10"
  }
}
